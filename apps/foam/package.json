{
  "name": "foam",
  "version": "0.1.1",
  "private": true,
  "description": "A resource management adventure game about single night in Brno.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/apps.git",
    "directory": "apps/foam"
  },
  "license": "AGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "type": "module",
  "scripts": {
    "build": "del-cli build && react-router build",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "codegen": "react-router typegen",
    "deploy": "flyctl deploy ../.. --config apps/foam/fly.toml",
    "develop": "react-router dev --port 5000",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "start": "cross-env NODE_ENV=production PORT=5000 react-router-serve ./build/server/index.js",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/ts-utils": "^3.0.20",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "cross-env": "^10.1.0",
    "isbot": "^5.2.2",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jakubmazanec/eslint-config": "^5.0.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": "^24.22.2",
    "npm": "^12.0.0"
  }
}
