{
  "name": "dram",
  "version": "0.7.1",
  "private": true,
  "description": "Whisky tasting notes app.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/apps.git",
    "directory": "apps/dram"
  },
  "license": "AGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "type": "module",
  "scripts": {
    "build": "del-cli build && react-router build",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "codegen": "react-router typegen",
    "deploy": "flyctl deploy ../.. --config apps/dram/fly.toml",
    "develop": "react-router dev --port 5000",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "migrate": "gel migration create && gel migrate && npm run codegen",
    "start": "cross-env NODE_ENV=production PORT=5000 react-router-serve ./build/server/index.js",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/ui": "^0.5.0",
    "@react-router/fs-routes": "^8.0.0",
    "@react-router/node": "^8.0.0",
    "@react-router/serve": "^8.0.0",
    "cross-env": "^10.0.0",
    "gel": "^2.1.1",
    "isbot": "^5.1.30",
    "lodash": "^4.17.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@gel/generate": "^0.6.4",
    "@jakubmazanec/eslint-config": "^5.0.0",
    "@react-router/dev": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.7.0",
    "fs-extra": "^11.3.1",
    "p-map": "^7.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.8"
  },
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": "^24.5.0",
    "npm": "^11.4.2"
  }
}
