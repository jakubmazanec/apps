{
  "name": "somewhere",
  "version": "0.1.22",
  "private": true,
  "description": "Location-based game.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/apps.git",
    "directory": "apps/somewhere"
  },
  "license": "AGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "type": "module",
  "scripts": {
    "build": "del-cli build && react-router build",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "codegen": "react-router typegen",
    "deploy": "flyctl deploy ../.. --config apps/somewhere/fly.toml",
    "develop": "react-router dev --port 5000",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint . --quiet",
    "start": "cross-env NODE_ENV=production PORT=5000 react-router-serve ./build/server/index.js",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/ts-utils": "^3.0.21",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "cross-env": "^10.1.0",
    "eventemitter3": "^5.0.4",
    "isbot": "^5.2.3",
    "lodash": "^4.18.1",
    "pixi-filters": "^5.3.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jakubmazanec/eslint-config": "^5.0.2",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^26.13.1",
    "npm": "^12.2.2"
  }
}
