{
  "name": "somewhere",
  "version": "0.1.22",
  "private": true,
  "description": "Location-based game.",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/apps.git",
    "directory": "apps/somewhere"
  },
  "license": "AGPL-3.0-only",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "type": "module",
  "scripts": {
    "build": "del-cli build && react-router build",
    "clean": "del-cli coverage build *.tsbuildinfo",
    "codegen": "react-router typegen",
    "deploy": "flyctl deploy ../.. --config apps/somewhere/fly.toml",
    "develop": "react-router dev --port 5000",
    "export-assets": "node scripts/export-assets.mjs",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "start": "cross-env NODE_ENV=production PORT=5000 react-router-serve ./build/server/index.js",
    "test": "del-cli coverage && vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@jakubmazanec/ts-utils": "^3.0.18",
    "@pixi/layout": "^3.2.0",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "cross-env": "^10.1.0",
    "eventemitter3": "^5.0.4",
    "isbot": "^5.2.1",
    "lodash": "^4.18.1",
    "pixi-filters": "^6.15.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jakubmazanec/eslint-config": "^5.0.0",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "fast-png": "^8.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.0.0"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.18.0"
  }
}
