input 36480 note-on 49 100
input 37440 note-on 50 100
input 38400 note-on 51 100
input 39360 note-on 52 100
input 40320 note-on 53 100
input 41280 note-on 54 100
input 42240 note-on 55 100
input 43200 note-on 56 100
input 44160 note-on 57 100
input 45120 note-on 58 100
input 46080 note-on 59 100
input 47040 note-on 60 100
input 48000 note-on 61 100
input 48960 note-on 62 100
input 49920 note-on 63 100
input 50880 note-on 64 100
input 51840 note-on 65 100
input 52800 note-on 66 100
input 53760 note-on 67 100
input 54720 note-on 68 100
input 55680 note-on 69 100
input 56640 note-on 70 100
input 57600 note-on 71 100
input 58560 note-on 72 100
input 59520 note-on 73 100
input 60480 note-on 74 100
input 61440 note-on 75 100
input 72000 note-off 36
input 72480 note-off 37
input 72960 note-off 38
input 73440 note-off 39
input 73920 note-off 40
input 74400 note-off 41
input 74880 note-off 42
input 75360 note-off 43
input 75840 note-off 44
input 76320 note-off 45
input 76800 note-off 46
input 77280 note-off 47
input 77760 note-off 48
input 78240 note-off 49
input 78720 note-off 50
input 79200 note-off 51
input 79680 note-off 52
input 80160 note-off 53
input 80640 note-off 54
input 81120 note-off 55
input 81600 note-off 56
input 82080 note-off 57
input 82560 note-off 58
input 83040 note-off 59
input 83520 note-off 60
input 84000 note-off 61
input 84480 note-off 62
input 84960 note-off 63
input 85440 note-off 64
