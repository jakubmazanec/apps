input 90240 note-off 74
input 90720 note-off 75
# A tap of PADS/KEYS goes back to PADS mode. PAGE + step 6: the Voice page. Down four times to
# Choke group and +: group 1.
input 96000 press pads-keys
input 97600 release pads-keys
input 99200 press page
input 100800 press step-6
input 102400 release step-6
input 104000 release page
input 105600 press down
input 107200 release down
input 108800 press down
input 110400 release down
input 112000 press down
input 113600 release down
input 115200 press down
input 116800 release down
input 118400 press plus
input 120000 release plus
# The hit on the empty pad 2 selects it, and New synth puts Syn 2 on it. SOUND shows the Voice page
# again, its cursor still on Choke group, and + puts Syn 2 in group 1 too.
input 121600 pad-hit 1 100
input 123200 pad-release 1
input 124800 press ok
input 126400 release ok
input 128000 press down
input 129600 release down
input 130000 press down
input 130400 release down
input 131200 press ok
input 132800 release ok
input 134400 press plus
input 136000 release plus
# Pad 1 plays Syn 1, which pad 2's Syn 2 chokes while pad 1 is still held. Pad 1 again chokes
# Syn 2.
input 140800 pad-hit 0 100
input 150400 pad-hit 1 100
input 155200 pad-release 0
input 160000 pad-hit 0 100
input 169600 pad-release 1
input 172800 pad-release 0
end 192000
