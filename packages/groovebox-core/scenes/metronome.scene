groovebox-scene 1
# kick.wav and pad.wav, a stereo file for the sample picker to preview.
file samples/kick.wav ours 55 0.3 1
file samples/pad.wav ours 220 2 2
# Syn 1 on pad 1 through the panel: MENU + step 3, then OK, down twice and OK in the sound picker.
# A tap of PADS/KEYS then makes the pads keys that play Syn 1.
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 16000 press down
input 17600 release down
input 19200 press ok
input 20800 release ok
input 22400 press pads-keys
input 24000 release pads-keys
# A tap of TEMPO turns the metronome on: TEMPO lights and the header ends with its icon. MENU +
# step 8 shows SETTINGS' Playing page with Metronome On.
input 25600 press tempo
input 27200 release tempo
input 28800 press menu
input 30400 press step-8
input 32000 release step-8
input 33600 release menu
frame 35200
# MENU + step 3 goes back to SOUND's Pad page. A loud chord of MIDI notes is held and PLAY starts
# the pattern: the metronome clicks on each beat, higher on a bar's first.
input 36800 press menu
input 38400 press step-3
input 40000 release step-3
input 41600 release menu
input 43200 note-on 48 127
input 43200 note-on 52 127
input 43200 note-on 55 127
input 43200 note-on 60 127
input 43200 note-on 64 127
input 43200 note-on 67 127
input 44800 press play
input 46400 release play
# Push 3 opens the Engine picker on Synth, and up onto Sample and OK open the sample picker on
# kick.wav, playing nothing. Down onto pad.wav previews it over the chord and the clicks.
input 48000 press push-3
input 49600 release push-3
input 51200 press up
input 52800 release up
input 54400 press ok
input 56000 release ok
input 57600 press down
input 59200 release down
# A tap of CANCEL closes the picker and stops the preview. Syn 1 stays a synth. MENU + step 1 shows
# STEP, playing, with the metronome icon after the tempo.
input 97600 press cancel
input 99200 release cancel
input 100800 press menu
input 102400 press step-1
input 104000 release step-1
input 105600 release menu
frame 108800
# TEMPO held shows the timing strip, Tempo and Grid. Encoder 1 moves the tempo 1 BPM a click, and
# 0.1 with SHIFT: 121.0, then 120.7. Let go after a turn, TEMPO leaves the metronome on.
input 110400 press tempo
input 112000 turn encoder-1 1
input 113600 press shift
input 115200 turn encoder-1 -3
input 116800 release shift
frame 118400
input 120000 release tempo
input 121600 note-off 48
input 121600 note-off 52
input 121600 note-off 55
input 121600 note-off 60
input 121600 note-off 64
input 121600 note-off 67
# MENU + step 9 shows PATTERN's Timing page: Tempo 120.7 and Grid 1/16.
input 123200 press menu
input 124800 press step-9
input 126400 release step-9
input 128000 release menu
frame 131200
# PAGE + step 2 shows the Bars page. Push 2 opens the Signature picker on 4/4, and right onto 4/8,
# down three times onto 7/8 and OK choose it. It takes hold at the next bar line, and from there
# the metronome clicks every eighth.
input 134400 press page
input 136000 press step-2
input 137600 release step-2
input 139200 release page
input 140800 press push-2
input 142400 release push-2
input 144000 press right
input 145600 release right
input 147200 press down
input 148800 release down
input 150400 press down
input 152000 release down
input 153600 press down
input 155200 release down
input 156800 press ok
input 158400 release ok
# The pattern's third bar is the first in 7/8, and bar 4's first beat clicks from 319,584. STOP at
# 319,800 stops the pattern and lets the click ring on. A second STOP while it rings silences it
# within the chunk.
input 319800 press stop
input 319900 release stop
input 320000 press stop
input 320100 release stop
end 324800
