groovebox-scene 1
# Four files as the device's import writes them, which the start-up loads: each the import's
# conversion of a drop of these sources, made once and pasted here.
#   drums/808/kick.wav  sine 55 0.3 44100 24 1
#   drums/clap.wav      sine 1500 0.1 96000 32f 1
#   Bass.wav            sine 110 0.25 44100 24 2
#   zap.wav             sine 3000 0.05 48000 16 1
file samples/drums/808/kick.wav base64 
file samples/drums/clap.wav base64 
file samples/Bass.wav base64 
file samples/zap.wav base64 
# MENU + step 10 opens SAMPLES at the top level: drums/, Bass.wav and zap.wav, with the cursor on
# drums/ and nothing playing.
input 3200 press menu
input 4800 press step-10
input 6400 release step-10
input 8000 release menu
frame 9600
# Down onto Bass.wav plays it, and down onto zap.wav cuts it short and plays zap.wav out.
input 11200 press down
input 12800 release down
input 14400 press down
input 16000 release down
# Up onto Bass.wav plays it again, and up onto drums/ stops it.
input 20800 press up
input 22400 release up
input 24000 press up
input 25600 release up
# OK enters drums/: its line, then "..", 808/ and clap.wav, with the cursor on "..".
input 27200 press ok
input 28800 release ok
frame 32000
# Down onto 808/ plays nothing, and down onto clap.wav plays it out.
input 32000 press down
input 33600 release down
input 35200 press down
input 36800 release down
# Up onto 808/ and OK enter 808/, and down onto kick.wav plays it out.
input 43200 press up
input 44800 release up
input 46400 press ok
input 48000 release ok
input 49600 press down
input 51200 release down
frame 54400
end 67200
