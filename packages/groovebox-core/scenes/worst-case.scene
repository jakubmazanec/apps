groovebox-scene 1
# kick.wav and pad.wav, a long stereo file for the sample picker to preview.
file samples/kick.wav ours 55 0.3 1
file samples/pad.wav ours 220 10 2
# The operation count plays this scene: the most a render batch has to do. 32 voices of a stereo
# sample sound at Transpose +48 cost more than 32 of a stereo Supersaw, as measured when sample
# sounds came. pad on pad 1 through the panel: MENU + step 3, then OK, down and OK in the sound
# picker open the sample picker on kick.wav, and down onto pad.wav and OK choose it. A tap of
# PADS/KEYS then makes the pads keys that play pad.
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 16000 press ok
input 17600 release ok
input 19200 press down
input 20800 release down
input 22400 press ok
input 24000 release ok
input 25600 press pads-keys
input 27200 release pads-keys
# Filter page: Resonance 100%.
input 28800 press page
input 30400 press step-3
input 32000 release step-3
input 33600 release page
input 35200 turn encoder-3 127
input 36800 turn encoder-3 1
# Volume envelope page: Release 10 s.
input 38400 press page
input 40000 press step-5
input 41600 release step-5
input 43200 release page
input 44800 turn encoder-4 127
# Voice page: down five times to Transpose and + held for 48 moves: +48, so the notes below read
# pad.wav 4 to 24 times as fast as it was recorded.
input 46400 press page
input 48000 press step-6
input 49600 release step-6
input 51200 release page
input 52800 press down
input 54400 release down
input 56000 press down
input 57600 release down
input 59200 press down
input 60800 release down
input 62400 press down
input 64000 release down
input 65600 press down
input 67200 release down
input 68800 press plus
input 201800 release plus
# Taps of steps 1 to 16 put a note of pad on every sixteenth of bar 1, at C4 in KEYS mode before
# any key, and PLAY starts the pattern, so the sequencer starts notes during the busiest batches.
input 204800 press step-1
input 206400 release step-1
input 208000 press step-2
input 209600 release step-2
input 211200 press step-3
input 212800 release step-3
input 214400 press step-4
input 216000 release step-4
input 217600 press step-5
input 219200 release step-5
input 220800 press step-6
input 222400 release step-6
input 224000 press step-7
input 225600 release step-7
input 227200 press step-8
input 228800 release step-8
input 230400 press step-9
input 232000 release step-9
input 233600 press step-10
input 235200 release step-10
input 236800 press step-11
input 238400 release step-11
input 240000 press step-12
input 241600 release step-12
input 243200 press step-13
input 244800 release step-13
input 246400 press step-14
input 248000 release step-14
input 249600 press step-15
input 251200 release step-15
input 252800 press step-16
input 254400 release step-16
input 256000 press play
input 257600 release play
# Sample page: push 1 opens the sample picker on pad.wav, playing nothing. Up onto kick.wav and
# down onto pad.wav preview it through to the end.
input 259200 press page
input 260800 press step-2
input 262400 release step-2
input 264000 release page
input 265600 press push-1
input 267200 release push-1
input 268800 press up
input 270400 release up
input 272000 press down
input 273600 release down
# 32 MIDI notes at once, one for each voice, held for a second.
input 275200 note-on 36 127
input 275200 note-on 37 127
input 275200 note-on 38 127
input 275200 note-on 39 127
input 275200 note-on 40 127
input 275200 note-on 41 127
input 275200 note-on 42 127
input 275200 note-on 43 127
input 275200 note-on 44 127
input 275200 note-on 45 127
input 275200 note-on 46 127
input 275200 note-on 47 127
input 275200 note-on 48 127
input 275200 note-on 49 127
input 275200 note-on 50 127
input 275200 note-on 51 127
input 275200 note-on 52 127
input 275200 note-on 53 127
input 275200 note-on 54 127
input 275200 note-on 55 127
input 275200 note-on 56 127
input 275200 note-on 57 127
input 275200 note-on 58 127
input 275200 note-on 59 127
input 275200 note-on 60 127
input 275200 note-on 61 127
input 275200 note-on 62 127
input 275200 note-on 63 127
input 275200 note-on 64 127
input 275200 note-on 65 127
input 275200 note-on 66 127
input 275200 note-on 67 127
input 323200 note-off 36
input 323200 note-off 37
input 323200 note-off 38
input 323200 note-off 39
input 323200 note-off 40
input 323200 note-off 41
input 323200 note-off 42
input 323200 note-off 43
input 323200 note-off 44
input 323200 note-off 45
input 323200 note-off 46
input 323200 note-off 47
input 323200 note-off 48
input 323200 note-off 49
input 323200 note-off 50
input 323200 note-off 51
input 323200 note-off 52
input 323200 note-off 53
input 323200 note-off 54
input 323200 note-off 55
input 323200 note-off 56
input 323200 note-off 57
input 323200 note-off 58
input 323200 note-off 59
input 323200 note-off 60
input 323200 note-off 61
input 323200 note-off 62
input 323200 note-off 63
input 323200 note-off 64
input 323200 note-off 65
input 323200 note-off 66
input 323200 note-off 67
end 329600
