groovebox-scene 1
# A storage of 72,970,000 bytes holding a 63.9 MB file at 48 kHz, which takes all but 48 blocks of
# the sample RAM: 63.9 of 64 MB.
storage 72970000
file samples/field-recording.wav ours 440 665.625 1
# MENU + step 10 opens SAMPLES on it.
input 3200 press menu
input 4800 press step-10
input 6400 release step-10
input 8000 release menu
frame 9600
# A 1 MB file needs 488 blocks: "big.wav not imported: library full", and the library stays as it
# was.
drop 11200 big.wav sine 440 10.4 48000 16 1
input 11200 dropped 1
frame 14464
# A 0.5 s file fits in the 48 blocks, but the storage's free space less the 9 MB reserve is 21,822
# bytes, below its 48,124: "small.wav not imported: storage full".
drop 16000 small.wav sine 440 0.5 48000 16 1
input 16000 dropped 1
frame 19200
end 20800
