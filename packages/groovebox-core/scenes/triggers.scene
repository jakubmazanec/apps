groovebox-scene 1
# Syn 1 on pad 1 of T4, the track the factory project leaves empty, through the panel: T4, then
# MENU + step 3, OK, down twice and OK in the sound picker.
input 1600 press t4
input 2400 release t4
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 14800 press down
input 15200 release down
input 16000 press ok
input 17600 release ok
# Gate: pad 1 held for 50 ms plays its release at once, held for a second it sustains.
input 22400 pad-hit 0 100
input 24800 pad-release 0
input 48000 pad-hit 0 100
input 96000 pad-release 0
# PAGE + step 6: the Voice page. Trigger One-shot: held for 50 ms or a second, the note plays to the
# end of its decay.
input 120000 press page
input 121600 press step-6
input 123200 release step-6
input 124800 release page
input 126400 turn encoder-4 1
input 129600 pad-hit 0 100
input 132000 pad-release 0
input 160000 pad-hit 0 100
input 208000 pad-release 0
end 230400
