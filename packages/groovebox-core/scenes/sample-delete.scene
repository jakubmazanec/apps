groovebox-scene 1
# kick.wav, the one file of the library.
file samples/kick.wav ours 55 0.3 1
# T4, which the factory project leaves empty, then MENU + step 3 shows SOUND's Pad page for its
# empty pad 1. OK, down onto New sample and OK open the sample picker on kick.wav, and OK chooses
# it: kick on pad 1.
input 1600 press t4
input 2400 release t4
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 16000 press ok
input 17600 release ok
input 19200 press ok
input 20800 release ok
# The hit on the empty pad 2 selects it, and New sample and kick.wav put kick 2 on it.
input 22400 pad-hit 1 100
input 24000 pad-release 1
input 25600 press ok
input 27200 release ok
input 28800 press down
input 30400 release down
input 32000 press ok
input 33600 release ok
input 35200 press ok
input 36800 release ok
# Pad 1 plays kick and is selected again. PAGE + step 2: the Sample page, Loop on. PAGE + step 6:
# the Voice page, Trigger Gate. A tap of PADS/KEYS switches T4 to KEYS mode, and pad 1 held rings
# round the loop.
input 38400 pad-hit 0 100
input 40000 pad-release 0
input 41600 press page
input 43200 press step-2
input 44800 release step-2
input 46400 release page
input 48000 turn encoder-4 1
input 49600 press page
input 51200 press step-6
input 52800 release step-6
input 54400 release page
input 56000 turn encoder-4 -1
input 57600 press pads-keys
input 59200 release pads-keys
input 60800 pad-hit 0 100
# MENU + step 10 opens SAMPLES on kick.wav. OK opens its Delete picker and OK on Delete asks
# "Delete kick.wav?", which 2 sounds use.
input 64000 press menu
input 65600 press step-10
input 67200 release step-10
input 68800 release menu
input 70400 press ok
input 72000 release ok
input 73600 press ok
input 75200 release ok
frame 76800
# OK deletes it: the ringing voice fades, and once the delete ends the header names kick in red.
input 80000 press ok
input 81600 release ok
frame 89600
input 91200 pad-release 0
# MENU + step 3 shows SOUND's Voice page again, and PAGE + step 1 its Pad page. OK opens the sound
# picker on kick, below the factory sounds, and down and up again bring kick 2's row into view:
# kick's row is red as kick 2's is.
input 92800 press menu
input 94400 press step-3
input 96000 release step-3
input 97600 release menu
input 99200 press page
input 100800 press step-1
input 102400 release step-1
input 104000 release page
input 105600 press ok
input 107200 release ok
input 107600 press down
input 107800 release down
input 108000 press up
input 108200 release up
frame 108800
# CANCEL closes it. kick.wav dropped again brings both sounds back, and pad 1 held plays kick.
input 110400 press cancel
input 112000 release cancel
drop 113600 kick.wav sine 55 0.3 48000 16 1
input 113600 dropped 1
input 142400 pad-hit 0 100
input 154400 pad-release 0
end 179200
