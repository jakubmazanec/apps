groovebox-scene 1
# Syn 1 on pad 1 of T4, the track the factory project leaves empty, through the panel: T4, then
# MENU + step 3, OK, down twice and OK in the sound picker.
input 1600 press t4
input 2400 release t4
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 14800 press down
input 15200 release down
input 16000 press ok
input 17600 release ok
# OK opens the picker again, on Syn 1, below the factory sounds.
input 19200 press ok
input 20800 release ok
frame 22400
# With the picker open pad 1 plays Syn 1, and the hit on the empty pad 2 does not select it.
input 25600 pad-hit 0 100
input 27200 pad-hit 1 100
input 28800 pad-release 1
input 30400 pad-release 0
# MENU, T2 and PADS/KEYS do nothing, neither when pressed nor when let go: no tiles while MENU is
# held, no other track and no KEYS mode.
input 32000 press menu
input 33600 press t2
input 35200 release t2
input 36800 press pads-keys
input 38400 release pads-keys
frame 40960
input 41600 release menu
end 44800
