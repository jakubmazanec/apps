groovebox-scene 1
# Two tracks playing, MIX, a mute while playing and the mutes under MENU, with the factory project's
# Kick on pad 1 of T1 and Bass on pad 1 of T2, each the selected sound of its track.
# Taps of steps 1, 5, 9 and 13 put Kick's notes on the beats of bar 1.
input 22400 press step-1
input 24000 release step-1
input 25600 press step-5
input 27200 release step-5
input 28800 press step-9
input 30400 release step-9
input 32000 press step-13
input 33600 release step-13
# T2 shows track 2 with Bass selected on its pad 1. Taps of steps 3, 7, 11 and 15 put Bass's notes
# between the beats, and T1 comes back.
input 35200 press t2
input 36800 release t2
input 51200 press step-3
input 52800 release step-3
input 54400 press step-7
input 56000 release step-7
input 57600 press step-11
input 59200 release step-11
input 60800 press step-15
input 62400 release step-15
input 64000 press t1
input 65600 release t1
# PLAY at 67,200 starts bar 1, which loops every 96,000 samples: T2's notes come at 79,200, 103,200
# and every 24,000 samples after them.
input 67200 press play
input 68800 release play
# MENU + step 5 shows MIX while the pattern plays: Track 1 to Track 4 and Master at 100%, with the
# cursor on Track 1.
input 70400 press menu
input 72000 press step-5
input 73600 release step-5
input 75200 release menu
frame 76800
# Encoder 2 takes Track 2 down 45 clicks to 65% and puts the cursor on it. Down three times onto
# Master and - held for 26 moves take it to 80%.
input 78400 turn encoder-2 -45
input 80000 press down
input 81600 release down
input 83200 press down
input 84800 release down
input 86400 press down
input 88000 release down
input 89600 press minus
input 168000 release minus
# SHIFT + T2 at 273,600, while T2's note of 271,200 sounds: the note keeps its end and plays its
# release, and T2's next notes start nothing. Track 2 reads "Track 2 muted" in red and the header
# "Mute 2". T2's button blinks once a second: lit at 297,600 and dark at 321,664.
input 272000 press shift
input 273600 press t2
input 275200 release t2
input 276800 release shift
frame 297600
frame 321664
# T2 and a hit of its pad 1 while it is muted: Bass sounds, as a hand-played note does.
input 324800 press t2
input 326400 release t2
input 328000 pad-hit 0 100
input 336000 pad-release 0
# MENU held and SHIFT + T4 mute track 4 too: MENU's tiles with Fx on step 4 and Mix, current, on
# step 5, and "Mute 2 4" in the header.
input 337600 press menu
input 339200 press shift
input 340800 press t4
input 342400 release t4
input 344000 release shift
frame 345600
input 347200 release menu
# SHIFT + T2 and SHIFT + T4 unmute both, and T2's notes sound again from the next that comes due.
input 348800 press shift
input 350400 press t2
input 352000 release t2
input 353600 press t4
input 355200 release t4
input 356800 release shift
end 460800
