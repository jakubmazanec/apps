input 177600 pad-release 9
# MENU + step 10 opens SAMPLES on drums/. Down onto hat.wav, OK, OK on Delete and OK on its
# question delete it: hat's sound is missing.
input 179200 press menu
input 180800 press step-10
input 182400 release step-10
input 184000 release menu
input 185600 press down
input 187200 release down
input 188800 press ok
input 190400 release ok
input 192000 press ok
input 193600 release ok
input 195200 press ok
input 196800 release ok
# MENU + step 6 opens POOL on Remove unused, as the empty pad 10 is selected, above the factory
# sounds. Right goes a page down onto snare-room, and down onto hat and up again bring hat's row
# into view: snare-room selected with pad 2, as in Look's pool.png below the factory sounds.
input 204800 press menu
input 206400 press step-6
input 208000 release step-6
input 209600 release menu
input 211200 press right
input 212000 release right
input 212800 press down
input 213600 release down
input 214400 press up
input 216000 release up
frame 217600
# Up onto kick and left a page up onto Remove unused keep kick, the sound passed, selected with pad
# 1. The hit on pad 12 selects it, and the cursor lands on kick.
input 220800 press up
input 222400 release up
input 224000 press left
input 225600 release left
input 227200 pad-hit 11 100
input 228800 pad-release 11
# A tap of PADS/KEYS switches T4 to KEYS mode. Down three times onto Syn 1 selects it on no pad,
# and pad 1 plays it at C4.
input 230400 press pads-keys
input 232000 release pads-keys
input 233600 press down
input 235200 release down
input 236800 press down
input 238400 release down
input 240000 press down
input 241600 release down
input 243200 pad-hit 0 100
input 249600 pad-release 0
# MENU + step 3 shows SOUND's Pad page with Engine alone, on encoder 3. MENU + step 6 shows POOL
# on Syn 1 again.
input 252800 press menu
input 254400 press step-3
input 256000 release step-3
input 257600 release menu
frame 259200
input 262400 press menu
input 264000 press step-6
input 265600 release step-6
input 267200 release menu
# A tap of PADS/KEYS goes back to PADS mode, as Look's pictures show. Up three times onto kick, OK
# and OK on Delete ask "Delete kick?", on 2 pads.
input 268800 press pads-keys
input 270400 release pads-keys
input 272000 press up
input 273600 release up
input 275200 press up
input 276800 release up
input 278400 press up
input 280000 release up
input 281600 press ok
input 283200 release ok
input 284800 press ok
input 286400 release ok
frame 288000
# CANCEL keeps it. Down three times onto Syn 1, OK, OK on Delete and OK on "Delete Syn 1?" delete
# it: its row goes, and the cursor goes up onto hat.
input 291200 press cancel
input 292800 release cancel
input 294400 press down
input 296000 release down
input 297600 press down
input 299200 release down
input 300800 press down
input 302400 release down
input 304000 press ok
input 305600 release ok
input 307200 press ok
input 308800 release ok
input 310400 press ok
input 312000 release ok
# Up twice and left a page up onto Remove unused, and OK asks "Remove 1 unused sound?": Syn 2, as
# Syn 5 sits on T2's pad 4 and the factory sounds on their pads.
input 313600 press up
input 315200 release up
input 316800 press up
input 318400 release up
input 320000 press left
input 321600 release left
input 323200 press ok
input 324800 release ok
frame 326400
# OK removes it. OK again: no question, and the header says "No unused sounds".
input 329600 press ok
input 331200 release ok
