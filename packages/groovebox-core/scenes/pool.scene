groovebox-scene 1
# drums/ with kick.wav and snare-room.wav (0.4 s and 1.2 s: 38 KB and 115 KB as in Look's
# pool.png); hat.wav at the top level.
file samples/drums/kick.wav ours 55 0.4 1
file samples/drums/snare-room.wav ours 180 1.2 1
file samples/hat.wav ours 3000 0.1 1
# T4, which the factory project leaves empty, then MENU + step 3 shows SOUND's Pad page for its
# empty pad 1. OK, down onto New sample and OK open the sample picker at the top level on drums/. OK
# enters drums/ on "..", and down onto kick.wav and OK choose it: kick on pad 1.
input 1600 press t4
input 2400 release t4
input 3200 press menu
input 4800 press step-3
input 6400 release step-3
input 8000 release menu
input 9600 press ok
input 11200 release ok
input 12800 press down
input 14400 release down
input 16000 press ok
input 17600 release ok
input 19200 press ok
input 20800 release ok
input 22400 press down
input 24000 release down
input 25600 press ok
input 27200 release ok
# The hit on the empty pad 12 selects it. OK, right a page down past the factory sounds onto kick,
# the last row, and OK: kick on pad 12 too.
input 28800 pad-hit 11 100
input 30400 pad-release 11
input 32000 press ok
input 33600 release ok
input 35200 press right
input 36800 release right
input 44800 press ok
input 46400 release ok
