{
  "name": "groovebox-core",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:jakubmazanec/apps.git",
    "directory": "packages/groovebox-core"
  },
  "license": "GPL-3.0-or-later",
  "author": "Jakub Mazanec <jakub@mazanec.dev>",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "clean": "cargo clean && del-cli build",
    "format": "cargo fmt --all && prettier . --write --ignore-unknown",
    "lint": "cargo clippy --workspace --all-targets -- --deny warnings",
    "test": "node build.js && node build.js --fallback && node check-imports.mjs && cargo test --workspace --exclude groovebox-browser && cargo test -p groovebox-core --features loom --release --lib queue::model && cargo build -p groovebox-core --release --target thumbv7em-none-eabihf",
    "toolchain": "node build.js --toolchains"
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.0"
  },
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": "^24.22.2",
    "npm": "^12.0.0"
  }
}
